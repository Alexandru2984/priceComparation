[Unit]
Description=PriceMatch local document processing worker
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=micu
Group=micu
WorkingDirectory=/home/micu/Desktop/priceComparision
EnvironmentFile=/home/micu/Desktop/priceComparision/.env
ExecStart=/home/micu/Desktop/priceComparision/.venv/bin/python manage.py process_document_queue --poll-seconds 2
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/micu/Desktop/priceComparision/media /home/micu/Desktop/priceComparision/data

[Install]
WantedBy=multi-user.target
