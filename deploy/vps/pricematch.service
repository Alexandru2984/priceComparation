[Unit]
Description=PriceMatch Django application
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=pricematch
Group=pricematch
WorkingDirectory=/srv/pricematch
EnvironmentFile=/etc/pricematch/pricematch.env
ExecStartPre=/srv/pricematch/.venv/bin/python manage.py migrate --noinput
ExecStartPre=/srv/pricematch/.venv/bin/python manage.py collectstatic --noinput
ExecStart=/srv/pricematch/.venv/bin/gunicorn pricecompare.wsgi:application --bind 127.0.0.1:8010 --workers 2 --timeout 180 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/pricematch/media /srv/pricematch/backups /srv/pricematch/data /srv/pricematch/staticfiles /srv/pricematch/reports

[Install]
WantedBy=multi-user.target
