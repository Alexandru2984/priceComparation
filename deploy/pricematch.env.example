# Copiază în /etc/pricematch/pricematch.env, apoi chmod 0640 root:pricematch.
DJANGO_SECRET_KEY=GENEREAZA_O_CHEIE_LUNGA_ALEATOARE
DJANGO_DEBUG=0
DJANGO_PRODUCTION=1
DJANGO_ALLOWED_HOSTS=preturi.example.ro
DJANGO_CSRF_TRUSTED_ORIGINS=https://preturi.example.ro
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_TRUST_PROXY=1
DJANGO_TRUSTED_PROXY_IPS=127.0.0.1,::1
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0
AXES_FAILURE_LIMIT=5
MFA_REQUIRED=1

DB_ENGINE=postgresql
DB_NAME=pricecompare
DB_USER=pricecompare
DB_PASSWORD=SCHIMBA_CU_PAROLA_POSTGRESQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Parserul local funcționează și fără Ollama; activează-l numai dacă VPS-ul are RAM suficient.
OLLAMA_ENABLED=0
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OCR_LANGUAGE=ron+eng

METRO_API_ENABLED=1
METRO_SELENIUM_ENABLED=0
METRO_STORE_QUERY=Targoviste
PREFERRED_METRO_STORE=METRO PUNCT TARGOVISTE
METRO_AUTOMATION_ENABLED=1
METRO_FULL_SCAN_INTERVAL_DAYS=7
METRO_TARGETED_SCAN_INTERVAL_HOURS=24
METRO_TARGETED_SCAN_MAX_PRODUCTS=150
ACTIVITY_LOG_RETENTION_DAYS=365
TECHNICAL_DATA_RETENTION_DAYS=30
INVOICE_REVISION_LIMIT=10

WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:admin@example.ro
