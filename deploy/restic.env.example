# Fișier root:pricematch 0640 la /etc/pricematch/restic.env.
# Exemple repository:
# RESTIC_REPOSITORY=sftp:backup@example.net:/srv/backups/pricematch
# RESTIC_REPOSITORY=s3:https://s3.example.net/pricematch
RESTIC_REPOSITORY=SCHIMBA_CU_REPOSITORY_EXTERN
RESTIC_PASSWORD_FILE=/etc/pricematch/restic-password
RESTIC_CACHE_DIR=/srv/pricematch/data/restic-cache

# Completează numai pentru un backend S3 compatibil.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-central-1
