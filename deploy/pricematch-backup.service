[Unit]
Description=PriceMatch daily backup
After=postgresql.service

[Service]
Type=oneshot
User=micu
Group=micu
WorkingDirectory=/home/micu/Desktop/priceComparision
EnvironmentFile=/home/micu/Desktop/priceComparision/.env
ExecStart=/home/micu/Desktop/priceComparision/.venv/bin/python manage.py backup_pricematch
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/micu/Desktop/priceComparision/backups /home/micu/Desktop/priceComparision/media
